 const _ = Gettext.gettext;
 
+var morphixCommandForSelection = function(fileItems) {
+    let argv = ['/usr/bin/morphix'];
+    if (!fileItems || fileItems.length === 0) {
+        argv.push('tray');
+    } else {
+        let uris = [];
+        for (let item of fileItems) {
+            try {
+                if (item.isSpecial || item.isDirectory || !item.file.is_native() ||
+                    item.file.query_file_type(Gio.FileQueryInfoFlags.NONE, null) !== Gio.FileType.REGULAR) {
+                    uris = [];
+                    break;
+                }
+                uris.push(item.file.get_uri());
+            } catch (error) {
+                console.error(error, 'Could not inspect the Desktop selection for Morphix.');
+                uris = [];
+                break;
+            }
+        }
+        if (uris.length === fileItems.length) {
+            argv.push('menu', '--uris', ...uris);
+        } else {
+            argv.push('tray', '--unsupported-selection');
+        }
+    }
+    return argv;
+};
+
+var launchMorphix = function(fileItems) {
+    try {
+        let argv = morphixCommandForSelection(fileItems);
+        DesktopIconsUtil.trySpawn(
+            null,
+            argv,
+            DesktopIconsUtil.getFilteredEnviron()
+        );
+    } catch (error) {
+        console.error(error, 'Could not start Morphix from the Desktop menu.');
+        new ShowErrorPopup.ShowErrorPopup(_('Morphix could not be opened'), error.message, true);
+    }
+};
