{
  "name": "morphix-gui-ui",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "tauri:dev": "tauri dev --config ../tauri.conf.json",
    "tauri:build": "tauri build --config ../tauri.conf.json",
    "tauri:icon": "tauri icon app-icon.svg --output ../icons"
  },
  "type": "module",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^26.6.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3"
  },
  "private": true,
  "description": "Morphix GUI frontend (Tauri webviews)"
}
