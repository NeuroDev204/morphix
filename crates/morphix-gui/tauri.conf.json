{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Morphix",
  "version": "0.1.1",
  "identifier": "vn.morphix.app",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "",
    "frontendDist": "./ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "menu",
        "title": "Morphix Menu",
        "url": "index.html",
        "width": 320,
        "height": 460,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "khay",
        "title": "Morphix",
        "url": "khay.html",
        "width": 440,
        "height": 700,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": false
      },
      {
        "label": "settings",
        "title": "Morphix Cài đặt",
        "url": "settings.html",
        "width": 420,
        "height": 520,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": [
      "appimage",
      "deb"
    ]
  }
}
