{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Morphix",
  "version": "0.1.2",
  "identifier": "vn.morphix.app",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "",
    "frontendDist": "./ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "khay",
        "title": "Morphix",
        "url": "khay.html",
        "width": 440,
        "height": 700,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": [
      "appimage",
      "deb"
    ]
  }
}
